# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~

# Packager output
.release/

# Generated dev-build TOC: never commit, never ship.
Foundry-1.0_DevBuild.toc

# Git worktrees (feature branches live in .worktrees/)
.worktrees/

# Wiki staging. The GitHub wiki is a SEPARATE repo (Foundry.wiki.git).
# Drafts live here for review, then publish to the wiki repo; they are not
# part of the code repo's history.
.wiki/

# Private dev environment (a separate nested repo): tracker,
# plans, and dev notes. Never part of the public code repo's history.
Foundry_Dev/

# Local agent instructions.
/AGENTS.md

# Claude Code session state and local commands (never tracked here).
.claude/
